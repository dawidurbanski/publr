// The content editor's sidebar chrome (was render.zig::renderSidebarHtml):
// publish/discard actions, an optional Details section holding the `.side`
// fields (pre-rendered by the adapter), the version-history slot, and the
// danger/delete form. Publish label + disabled state and the discard button's
// visibility are computed by the adapter and passed in; the release/history/
// side-fields HTML come in as {@raw} slots.
pub fn EntrySidebar(props: struct {
    publish_label: ?[]const u8 = null,
    publish_disabled: bool = false,
    show_discard: bool = false,
    discard_hidden: bool = false,
    release_html: []const u8 = "",
    has_side_fields: bool = false,
    side_fields_html: []const u8 = "",
    history_html: []const u8 = "",
    entry_id: []const u8 = "",
    csrf_token: []const u8 = "",
    type_id: []const u8 = "",
    display_name: []const u8 = "",
}) {
    <div
        class="edit-sidebar-section border-b border-border px-6 py-4 last:border-b-0"
    >
        <div class="edit-sidebar-actions flex flex-col gap-2">
            <div
                class="autosave-status min-h-[1.125rem] text-center text-xs leading-[1.125rem]"
                id="autosave-status"
            ></div>
            {if (props.publish_label != null) (
                <button
                    type="submit"
                    form="entry-form"
                    name="status"
                    value="published"
                    class="btn btn-primary inline-flex w-full cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-primary bg-primary px-3 py-2 text-sm font-semibold leading-5 text-primary-foreground shadow-xs transition-opacity hover:opacity-90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50"
                    id="publish-btn"
                    disabled?={props.publish_disabled}
                >
                    {props.publish_label.?}
                </button>
            )}
            {if (props.show_discard) (
                <button
                    type="button"
                    class={props.discard_hidden ? "btn btn-ghost hidden inline-flex w-full cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-2 text-sm font-semibold leading-5 text-secondary-foreground transition-colors hover:bg-accent" : "btn btn-ghost inline-flex w-full cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-2 text-sm font-semibold leading-5 text-secondary-foreground transition-colors hover:bg-accent"}
                    id="discard-btn"
                >
                    Discard Changes
                </button>
            )}
            {@raw props.release_html}
        </div>
    </div>
    {if (props.has_side_fields) (
        <div
            class="edit-sidebar-section border-b border-border px-6 py-4 last:border-b-0"
        >
            <h3
                class="edit-sidebar-title m-0 mb-2 text-sm font-semibold text-muted-foreground"
            >
                Details
            </h3>
            {@raw props.side_fields_html}
        </div>
    )}
    {@raw props.history_html}
    {if (props.entry_id.len > 0) (
        <div
            class="edit-sidebar-section edit-sidebar-danger mt-auto border-b border-border px-6 py-4 last:border-b-0"
        >
            <form
                method="POST"
                action="/admin/action"
                onsubmit={`return confirm('Delete this ${props.display_name} permanently?')`}
            >
                <input type="hidden" name="_csrf" value={props.csrf_token} />
                <input type="hidden" name="action" value="content.delete" />
                <input type="hidden" name="type" value={props.type_id} />
                <input type="hidden" name="entry_id" value={props.entry_id} />
                <button
                    type="submit"
                    class="btn btn-danger btn-sm inline-flex w-full cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-destructive bg-destructive px-3 py-1.5 text-sm font-semibold leading-5 text-primary-foreground shadow-xs transition-opacity hover:opacity-90"
                >
                    Delete
                </button>
            </form>
        </div>
    )}
}
