// VersionFlowAudit — flow-history audit events for a single version (was
// editor_json.zig::buildVersionFlowAuditHtml). The adapter runs the DB query and computes the
// per-event action label, optional "Step N -> M" text, "<timestamp> UTC" title, relative time
// and actor; this renders the audit container + per-event rows with the original zero-whitespace
// inline layout. The adapter returns "" when there are no events, so this always has >=1 event.
pub fn VersionFlowAudit(props: struct {
    events: []const struct {
        action_label: []const u8 = "",
        step_text: ?[]const u8 = null,
        time_title: []const u8 = "",
        relative: []const u8 = "",
        actor: []const u8 = "",
    } = &.{},
}) {
    <div
        class="version-flow-audit flex flex-col gap-2 rounded-[calc(var(--radius)*0.8)] border border-border bg-background p-3"
    >
        {for (props.events) |e| (<div class="version-flow-event flex flex-col gap-1 border-b border-border pb-1.5 last:border-b-0 last:pb-0"><span class="version-flow-action text-xs font-medium text-muted-foreground">{e.action_label}</span>{if (e.step_text != null) (<span class="version-flow-step text-[11px] text-muted-foreground">{@raw e.step_text.?}</span>)}<span class="version-flow-time text-[11px] text-muted-foreground" title={e.time_title}>{e.relative} · {e.actor}</span>
    </div>
    )}</div>
}
