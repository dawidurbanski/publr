// Topbar navigation — horizontal nav items in the top bar

const Icon = @import("publr_ui").icon.Icon;
const Size = @import("publr_ui").icon.Size;

pub fn TopbarNav(props: struct { items: anytype }) {
    {for (props.items) |item| (
        <a
            href={item.path}
            class={if (item.is_active)
                "topbar-nav-item active flex items-center gap-2 border-b-2 border-primary px-3 py-2 text-sm font-medium text-foreground no-underline transition-colors"
            else
                "topbar-nav-item flex items-center gap-2 border-b-2 border-transparent px-3 py-2 text-sm font-medium text-muted-foreground no-underline transition-colors hover:border-primary hover:text-foreground hover:no-underline"}
        >
            <span
                class="nav-icon flex h-[18px] w-[18px] shrink-0 items-center [&_.icon]:h-full [&_.icon]:w-full"
            >
                <Icon name={item.icon} size={Size.md} />
            </span>
            {item.label}
        </a>
    )}
}
