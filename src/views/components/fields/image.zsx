// Image field control — media-library picker.
//
// Each field is its own local:image-field PublrJS island (static/
// image-field.js): `pick` opens the shared media-picker dialog and writes the
// result into the hidden input + parts; `clear` resets them. (The
// renderDefaultField `data-widget="media-picker"` fallback is dead and gets
// dropped in A5/#196.)
//
// `has_value` is computed by the adapter (value.len > 0); the ternaries below
// pick the state, preview, button label, and the remove button's visibility.

pub fn Image(props: struct {
    name: []const u8,
    display_name: []const u8,
    value: []const u8 = "",
    has_value: bool = false,
    required: bool = false,
    errors: []const []const u8 = &.{},
}) {
    <FieldLabelRow
        name={props.name}
        display_name={props.display_name}
        required={props.required}
        errors={props.errors}
    >
        <div
            @store="local:image-field"
            class="image-picker overflow-hidden rounded-[calc(var(--radius)*0.8)] border border-border bg-muted"
            data-publr-state={props.has_value ? "selected" : "empty"}
        >
            <input
                type="hidden"
                name={props.name}
                value={props.value}
                data-publr-part="value"
            />
            <div
                class="image-picker-preview flex min-h-[120px] items-center justify-center border-b border-border bg-muted"
                data-publr-part="preview"
            >
                {if (props.has_value) (
                    <img
                        src={`/admin/media/picker/thumb/${props.value}`}
                        alt=""
                        class="image-picker-thumb block max-h-[200px] max-w-full object-contain"
                    />
                ) else (
                    <div
                        class="image-picker-placeholder flex flex-col items-center gap-2 p-4 text-muted-foreground"
                    >
                        <svg
                            class="icon h-8 w-8 opacity-50"
                            viewBox="0 0 24 24"
                            fill="none"
                        >
                            <path d="M4 16L8.58579 11.4142C9.36683 10.6332 10.6332 10.6332 11.4142 11.4142L16 16M14 14L15.5858 12.4142C16.3668 11.6332 17.6332 11.6332 18.4142 12.4142L20 14M14 8H14.01M6 20H18C19.1046 20 20 19.1046 20 18V6C20 4.89543 19.1046 4 18 4H6C4.89543 4 4 4.89543 4 6V18C4 19.1046 4.89543 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <span class="text-sm">No image selected</span>
                    </div>
                )}
            </div>
            <div class="image-picker-actions flex gap-2 bg-muted p-3">
                <button
                    type="button"
                    class="btn btn-sm inline-flex cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-input bg-secondary px-3 py-1.5 text-sm font-semibold leading-5 text-secondary-foreground shadow-xs hover:bg-accent"
                    data-publr-part="trigger"
                    onClick="pick"
                >
                    {props.has_value ? "Change Image" : "Select Image"}
                </button>
                <button
                    type="button"
                    class={props.has_value ? "btn btn-sm btn-ghost inline-flex cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-1.5 text-sm font-semibold leading-5 text-secondary-foreground hover:bg-accent" : "btn btn-sm btn-ghost hidden cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-1.5 text-sm font-semibold leading-5 text-secondary-foreground hover:bg-accent"}
                    data-publr-part="remove"
                    onClick="clear"
                >
                    Remove
                </button>
            </div>
            <div
                class="image-picker-alt empty:hidden px-3 pb-3 text-sm text-muted-foreground"
                data-publr-part="alt"
            ></div>
        </div>
    </FieldLabelRow>
}
