// Taxonomy field control — categorical terms via the
// `data-widget="taxonomy-picker"` widget (dispatched by interact/core.js's
// generic [data-widget] registry). `label` is the humanized taxonomy name used
// in the button ("Select Category"); `many` → data-many "true"/"false".

pub fn Taxonomy(props: struct {
    name: []const u8,
    display_name: []const u8,
    value: []const u8 = "",
    required: bool = false,
    taxonomy_id: []const u8,
    many: bool = true,
    label: []const u8,
    errors: []const []const u8 = &.{},
}) {
    <FieldLabelRow name={props.name} display_name={props.display_name} required={props.required} errors={props.errors}>
        <div data-widget="taxonomy-picker" data-taxonomy={props.taxonomy_id} data-many={props.many ? "true" : "false"} data-name={props.name} data-value={props.value}>
            <input type="hidden" name={props.name} value={props.value} />
            <button type="button" class="btn btn-sm">Select {props.label}</button>
        </div>
    </FieldLabelRow>
}
