// VersionAvatars — collaborator avatar stack (was editor_json.zig::writeCollaboratorAvatars).
// The Zig adapter parses the collaborator JSON, resolves gravatar URLs + titles, and picks a
// variant; these leaf templates each render one shape with a static-tag root and no leading/
// trailing whitespace so the markup stays inline (valid inside the <span> parents that embed
// it — no display:contents wrapper).

pub fn Stack(props: struct {
    avatars: []const struct { url: []const u8, title: []const u8 } = &.{},
    overflow: usize = 0,
}) {<span class="version-avatars">{for (props.avatars) |a| (<img src={a.url} alt="" title={a.title} class="version-avatar version-avatar-stacked" />)}{if (props.overflow > 0) (<span class="version-avatar version-avatar-overflow">+{props.overflow}</span>)}</span>}

pub fn Single(props: struct {
    url: []const u8 = "",
    title: []const u8 = "",
}) {<img src={props.url} alt="" title={props.title} class="version-avatar" />}

pub fn System(props: struct {}) {<span class="version-avatar version-avatar-system">S</span>}
