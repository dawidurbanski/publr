// VersionHistory — the version-history sidebar list (was editor_json.zig::buildVersionHistoryHtml).
// The adapter runs the DB query, computes relative times + compare/flow URLs, and pre-renders
// each row's collaborator-avatar fragment ({@raw avatars_html}); this renders the sidebar
// chrome + per-version rows with the original zero-whitespace inline layout.
pub fn VersionHistory(props: struct {
    rows: []const struct {
        is_current: bool = false,
        avatars_html: []const u8 = "",
        version_type: []const u8 = "",
        release_name: ?[]const u8 = null,
        time_str: []const u8 = "",
        compare_url: []const u8 = "",
        flow_url: []const u8 = "",
    } = &.{},
}) {
    <div
        class="edit-sidebar-section border-b border-border px-6 py-4 last:border-b-0"
    >
        <h3
            class="edit-sidebar-title m-0 mb-2 text-sm font-semibold text-muted-foreground"
        >
            Version History
        </h3>
        <div
            class="version-list flex flex-col gap-px overflow-hidden rounded-[calc(var(--radius)*0.8)] bg-border"
        >
            {for (props.rows) |r| (<div class={r.is_current ? "version-item version-history-item version-current group flex items-center gap-2 bg-muted px-3 py-2 text-sm text-foreground transition-colors" : "version-item version-history-item group flex items-center gap-2 bg-background px-3 py-2 text-sm text-foreground transition-colors hover:bg-muted"}>{@raw r.avatars_html}<span class="version-info flex min-w-0 flex-1 flex-col"><span class="version-type font-medium capitalize">{r.version_type}</span>{if (r.release_name != null) (<span class="version-release text-xs text-primary">{r.release_name.?}</span>)}<span class="version-time text-xs text-muted-foreground">{r.time_str}</span></span><span class="version-item-actions pointer-events-none ml-auto inline-flex items-center gap-1.5 opacity-0 transition-opacity group-hover:pointer-events-auto group-hover:opacity-100 group-focus-within:pointer-events-auto group-focus-within:opacity-100">{if (!r.is_current) (<a href={r.compare_url} class="version-action inline-flex items-center justify-center rounded-[calc(var(--radius)*0.6)] border border-border bg-background px-2 py-0.5 text-[11px] leading-[1.4] text-muted-foreground no-underline hover:bg-muted hover:text-foreground hover:no-underline">Compare</a>)}<a href={r.flow_url} class="version-action inline-flex items-center justify-center rounded-[calc(var(--radius)*0.6)] border border-border bg-background px-2 py-0.5 text-[11px] leading-[1.4] text-muted-foreground no-underline hover:bg-muted hover:text-foreground hover:no-underline">Flow</a>{if (r.is_current) (<span class="version-badge text-xs font-semibold text-primary">current</span>)}</span>
        </div>
        )}</div></div>
}
