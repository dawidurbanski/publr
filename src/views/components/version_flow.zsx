// VersionFlow — flow/audit view for a single version (was versions.zig::versionFlowFor).
// The adapter computes the author label, relative time, and pre-renders the flow-audit
// HTML; this renders the header chrome and the flow-history slot.
pub fn VersionFlow(props: struct {
    author_str: []const u8 = "",
    time_str: []const u8 = "",
    version_type: []const u8 = "",
    is_current: bool = false,
    compare_url: []const u8 = "",
    flow_html: []const u8 = "",
}) {
    <div class="version-flow-view">
        <div class="version-preview-header">
            <div class="version-preview-meta">
                <span class="version-preview-author">{props.author_str}</span>
                <span class="version-preview-time">{props.time_str} · {props.version_type}</span>
            </div>
            {if (props.is_current) (
                <span class="badge-current">Current version</span>
            ) else (
                <a href={props.compare_url} class="btn btn-sm">Compare</a>
            )}
        </div>
        <h3 class="version-preview-subtitle">Flow history</h3>
        {if (props.flow_html.len > 0) ({@raw props.flow_html}) else (<p class="diff-error">No flow events recorded for this version.</p>)}
    </div>
}
