// VersionSidebar — the edit-sidebar chrome shared by the version compare and flow views
// (was the inline sidebar builders in versions.zig): a "Back to Editor" action plus the
// pre-rendered version-history HTML slot.
pub fn VersionSidebar(props: struct {
    back_url: []const u8 = "",
    history_html: []const u8 = "",
}) {
    <div
        class="edit-sidebar-section border-b border-border px-6 py-4 last:border-b-0"
    >
        <div class="edit-sidebar-actions flex flex-col gap-2">
            <a
                href={props.back_url}
                class="btn inline-flex w-full cursor-pointer items-center justify-center gap-1 rounded-[calc(var(--radius)*0.8)] border border-input bg-secondary px-3 py-2 text-sm font-semibold leading-5 text-secondary-foreground no-underline shadow-xs transition-colors hover:bg-accent hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
            >
                Back to Editor
            </a>
        </div>
    </div>
    {@raw props.history_html}
}
