const std = @import("std");
const ui = @import("publr_ui");
const MediaPicker = @import("../components/media_picker.zig").MediaPicker;

const ContentTypeNav = struct {
    href: []const u8,
    label: []const u8,
    type_id: []const u8 = "",
};

pub const PluginNav = struct {
    id: []const u8,
    href: []const u8,
    label: []const u8,
    icon: IconName,
};
const Icon = ui.icon.Icon;
const IconName = ui.icon.Name;
const Flex = ui.flex.Flex;
const Stack = ui.stack.Stack;
const Avatar = ui.avatar.Avatar;
const AvatarImage = ui.avatar.AvatarImage;
const ToastRegion = ui.toast.ToastRegion;
const TooltipProvider = ui.tooltip.TooltipProvider;
const SidebarRail = ui.sidebar.SidebarRail;
const RailLink = ui.sidebar.RailLink;
const SidebarNavItem = ui.sidebar.SidebarNavItem;
const SidebarNavTree = ui.sidebar.SidebarNavTree;
const SidebarNavSubItem = ui.sidebar.SidebarNavSubItem;
const Breadcrumb = ui.breadcrumbs.Breadcrumb;
const BreadcrumbList = ui.breadcrumbs.BreadcrumbList;
const BreadcrumbItem = ui.breadcrumbs.BreadcrumbItem;
const BreadcrumbLink = ui.breadcrumbs.BreadcrumbLink;
const BreadcrumbPage = ui.breadcrumbs.BreadcrumbPage;
const BreadcrumbSeparator = ui.breadcrumbs.BreadcrumbSeparator;
const Drawer = ui.drawer.Drawer;
const DrawerHeader = ui.drawer.DrawerHeader;
const DrawerContent = ui.drawer.DrawerContent;

/// Uppercase micro eyebrow between context-nav sections.
fn NavEyebrow(props: struct { label: []const u8, first: bool = false }) {
    const pad = if (props.first) "px-2 pb-1.5 pt-2" else "px-2 pb-1.5 pt-5";
    <p
        class={`${@raw pad} text-3xs font-semibold uppercase tracking-[0.1em] text-muted-foreground`}
    >
        {props.label}
    </p>
}

/// One environment choice row in the environment switcher panel.
fn EnvironmentChoice(props: struct {
    name: []const u8,
    description: []const u8,
    icon: IconName,
    tone_bg: []const u8,
    tone_text: []const u8,
    tone_dot: []const u8,
    selected_class: []const u8,
}) {
    <button
        type="button"
        data-environment={props.name}
        onClick="setEnvironment"
        data-p-class={`environment|eq|${props.name}->${props.selected_class}~border-border+bg-card`}
        class="flex w-full cursor-pointer items-center gap-3 rounded-lg border border-border bg-card p-3 text-left transition-colors hover:bg-muted/30"
    >
        <span
            class={`inline-flex size-8 shrink-0 items-center justify-center rounded-md ${@raw props.tone_bg} ${@raw props.tone_text}`}
        >
            <Icon name={props.icon} size={16} class="size-4" />
        </span>
        <span class="min-w-0 flex-1">
            <span class="block text-sm font-semibold text-foreground">{props.name}</span>
            <span
                class="mt-0.5 block text-2xs text-muted-foreground"
            >
                {props.description}
            </span>
        </span>
        <span
            data-p-show={`environment|eq|${props.name}`}
            class={`size-2 shrink-0 rounded-full ${@raw props.tone_dot}`}
        >

        </span>
    </button>
}

pub fn Layout(props: struct {
    title: []const u8,
    content: []const u8,
    csrf_token: []const u8,
    user_gravatar_url: []const u8,
    user_email: []const u8 = "",
    user_name: []const u8 = "",
    current_section: []const u8 = "",
    bottom_bar: []const u8 = "",
    topbar_nav_html: []const u8 = "",
    content_types: []const ContentTypeNav = &.{},
    plugin_pages: []const PluginNav = &.{},
    /// When the user is viewing a specific content type (list or edit) or
    /// `/admin/content?type=<id>`, this is that type's id. Drives sidebar
    /// active state: the matching content-type item lights up.
    active_content_type_id: []const u8 = "",
    /// Active saved-view filter for the Content section sidebar. One of
    /// `"all"`, `"recent"`, `"created_by_me"`, `"updated_by_me"`, or
    /// `"status_<value>"`. Empty when no filter applies.
    active_content_view: []const u8 = "",
    /// Rail-only shell: hides the context-nav column so wide surfaces
    /// (media library, editors) get the full width. Desktop keeps the icon
    /// rail; mobile has no nav drawer in this mode.
    compact_nav: bool = false,
}) {
    const sec = props.current_section;
    const in_dashboard = std.mem.eql(u8, sec, "dashboard");
    const in_content = std.mem.eql(u8, sec, "content") or std.mem.startsWith(u8, sec, "content.");
    const in_media = std.mem.eql(u8, sec, "media") or std.mem.startsWith(u8, sec, "media.");
    const in_releases = std.mem.eql(u8, sec, "releases");
    const in_content_types = std.mem.eql(u8, sec, "content_types");
    const in_settings = std.mem.eql(u8, sec, "settings");

    const aside_class = if (props.compact_nav)
        "fixed inset-y-0 left-0 z-50 hidden w-12 flex-row border-r border-border bg-sidebar lg:flex"
    else
        "fixed inset-y-0 left-0 z-50 flex w-64 flex-row max-lg:-translate-x-full border-r border-border bg-sidebar transition-transform duration-200 ease-out lg:translate-x-0";
    const main_pad = if (props.compact_nav) "lg:pl-12" else "lg:pl-64";

    <!DOCTYPE html>
    <html class="dark h-full">
        <head>
            <meta charset="utf-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1, viewport-fit=cover"
            />
            <title>{props.title} - Publr Admin</title>
            <link rel="icon" type="image/svg+xml" href="/static/logo.svg" />
            <link rel="stylesheet" href="/static/styles/tokens.css" />
            <link rel="stylesheet" href="/static/styles/publr.css" />
            <script>
                {@raw "(function(){var t=localStorage.getItem('publr-theme');if(t==='light')document.documentElement.classList.remove('dark');else if(t==='dark')document.documentElement.classList.add('dark');})();"}
            </script>
        </head>
        <body
            class="admin min-h-screen bg-background text-foreground antialiased [scrollbar-color:oklch(0.15_0_0/0.3)_transparent] [scrollbar-width:thin]"
            @store="shell"
            onKeydown.esc.window="close"
        >
            <div @store="local:recompile-bar" class="contents">
                <div :showIf="$visible" class="hidden">
                    <div
                        class="recompile-bar fixed inset-x-0 top-0 z-1200 flex h-9 items-center justify-center gap-3 text-sm text-white [&_a]:font-semibold [&_a]:text-white [&_a]:underline"
                        :class="$normal -> bg-primary; $success -> bg-success; $error -> bg-destructive"
                    >
                        <span :text="$text"></span>
                        <a
                            href="#"
                            class="hidden"
                            :showIf="$hasAction"
                            onClick.prevent="actionClick"
                            :text="$actionLabel"
                        >

                        </a>
                    </div>
                </div>
            </div>
            <span class="hidden pl-96 pt-9" aria-hidden="true"></span>
            <TooltipProvider>
                <div
                    :showIf="$open"
                    onClick="close"
                    class="fixed inset-0 z-40 bg-black/40 lg:hidden hidden"
                    aria-hidden="true"
                >

                </div>
                <aside
                    data-publr-component="admin-sidebar"
                    :class="$open == false -> max-lg:-translate-x-full"
                    onClick="navClose"
                    class={aside_class}
                    aria-label="Admin navigation"
                >
                    <SidebarRail>
                        <a
                            href="/admin"
                            aria-label="Publr"
                            class="mb-2 inline-flex h-12 w-full items-center justify-center border-b border-border no-underline hover:no-underline"
                        >
                            <span
                                class="inline-flex size-7 items-center justify-center rounded-full bg-foreground text-sm font-bold leading-none text-background"
                            >
                                P
                            </span>
                        </a>
                        <nav class="flex flex-col gap-1" aria-label="Primary">
                            <RailLink
                                href="/admin"
                                label="Dashboard"
                                icon=.grid
                                is_active={in_dashboard}
                            />
                            <RailLink
                                href="/admin/content"
                                label="Content"
                                icon=.file
                                is_active={in_content}
                            />
                            <RailLink
                                href="/admin/media"
                                label="Media"
                                icon=.image
                                is_active={in_media}
                            />
                            <RailLink
                                href="/admin/releases"
                                label="Releases"
                                icon=.calendar_check_02
                                is_active={in_releases}
                            />
                        </nav>
                        <nav class="mt-auto flex flex-col gap-1" aria-label="System">
                            <RailLink
                                href="/admin/content-types"
                                label="Content types"
                                icon=.components
                                is_active={in_content_types}
                            />
                            <RailLink
                                href="/admin/settings"
                                label="Settings"
                                icon=.settings
                                is_active={in_settings}
                            />
                        </nav>
                    </SidebarRail>
                    {if (!props.compact_nav) (
                    <div class="flex min-w-0 flex-1 flex-col bg-sidebar">
                        <div class="flex h-12 items-center border-b border-border px-2">
                            <button
                                type="button"
                                onClick="openCommand"
                                class="inline-flex h-8 min-w-0 flex-1 cursor-pointer items-center justify-start gap-1.5 rounded-md border border-border bg-card px-2.5 text-xs font-semibold text-muted-foreground shadow-xs transition duration-150 hover:bg-accent"
                            >
                                <Icon name=.search size={16} class="size-4 shrink-0" />
                                <span class="px-0.5">Search</span>
                                <span
                                    class="ml-auto font-mono text-3xs text-muted-foreground"
                                >
                                    ⌘K
                                </span>
                            </button>
                            <button
                                type="button"
                                onClick="close"
                                aria-label="Close navigation"
                                class="ml-1 inline-flex size-8 cursor-pointer items-center justify-center rounded-md text-muted-foreground hover:bg-accent hover:text-foreground lg:hidden"
                            >
                                <Icon name=.x_close size={16} class="size-4" />
                            </button>
                        </div>
                        <nav class="flex-1 overflow-y-auto px-2 pb-3" aria-label="Sections">
                            <NavEyebrow label="Workspace" first={true} />
                            <SidebarNavItem
                                href="/admin"
                                label="Overview"
                                is_active={in_dashboard}
                            />
                            <SidebarNavItem
                                href="/admin/content"
                                label="Content"
                                is_active={in_content and props.active_content_type_id.len == 0}
                                class="mt-0.5"
                            />
                            {if (in_content) (
                                <SidebarNavTree>
                                    {for (props.content_types) |ct| (
                                        <SidebarNavSubItem
                                            href={ct.href}
                                            label={ct.label}
                                            is_active={std.mem.eql(u8, props.active_content_type_id, ct.type_id)}
                                        />
                                    )}
                                </SidebarNavTree>
                            )}
                            <SidebarNavItem
                                href="/admin/media"
                                label="Media"
                                is_active={in_media}
                                class="mt-0.5"
                            />
                            <SidebarNavItem
                                href="/admin/releases"
                                label="Releases"
                                is_active={in_releases}
                                class="mt-0.5"
                            />
                            <NavEyebrow label="Structure" />
                            <SidebarNavItem
                                href="/admin/content-types"
                                label="Content types"
                                is_active={in_content_types}
                            />
                            <NavEyebrow label="Saved views" />
                            <SidebarNavItem
                                href="/admin/content?recent=1"
                                label="Recent"
                                is_active={std.mem.eql(u8, props.active_content_view, "recent")}
                            />
                            <SidebarNavItem
                                href="/admin/content?author=me"
                                label="Created by me"
                                is_active={std.mem.eql(u8, props.active_content_view, "created_by_me")}
                                class="mt-0.5"
                            />
                            <SidebarNavItem
                                href="/admin/content?editor=me"
                                label="Updated by me"
                                is_active={std.mem.eql(u8, props.active_content_view, "updated_by_me")}
                                class="mt-0.5"
                            />
                            <SidebarNavItem
                                href="/admin/content?status=draft"
                                label="Drafts"
                                is_active={std.mem.eql(u8, props.active_content_view, "status_draft")}
                                class="mt-0.5"
                            />
                            <SidebarNavItem
                                href="/admin/content?status=published"
                                label="Published"
                                is_active={std.mem.eql(u8, props.active_content_view, "status_published")}
                                class="mt-0.5"
                            />
                            <NavEyebrow label="System" />
                            <SidebarNavItem
                                href="/admin/settings"
                                label="Settings"
                                is_active={in_settings}
                            />
                            {if (props.plugin_pages.len > 0) (
                                <NavEyebrow label="Plugins" />
                                {for (props.plugin_pages) |p| (
                                    <SidebarNavItem
                                        href={p.href}
                                        label={p.label}
                                        is_active={std.mem.eql(u8, sec, p.id)}
                                        class="mt-0.5"
                                    />
                                )}
                            )}
                        </nav>
                        <Flex items=.center class="gap-2.5 border-t border-sidebar-border p-2">
                            <Avatar size=.sm>
                                <AvatarImage
                                    src={props.user_gravatar_url}
                                    alt=""
                                    class=""
                                />
                            </Avatar>
                            <Stack gap=.none class="min-w-0 flex-1">
                                {if (props.user_name.len > 0) (
                                    <span
                                        class="truncate text-xs font-medium leading-4 text-foreground"
                                    >
                                        {props.user_name}
                                    </span>
                                    <span
                                        class="truncate text-2xs leading-4 text-muted-foreground"
                                    >
                                        {props.user_email}
                                    </span>
                                ) else (
                                    <span
                                        class="truncate text-xs font-medium text-foreground"
                                    >
                                        {props.user_email}
                                    </span>
                                )}
                            </Stack>
                            <form
                                method="POST"
                                action="/admin/logout"
                                class="inline-flex shrink-0"
                            >
                                <input
                                    type="hidden"
                                    name="_csrf"
                                    value={props.csrf_token}
                                />
                                <button
                                    type="submit"
                                    class="inline-flex size-7 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground"
                                    aria-label="Logout"
                                >
                                    <Icon name=.logout size={13} />
                                </button>
                            </form>
                        </Flex>
                    </div>
                    )}
                </aside>
                <div class={main_pad}>
                    <header
                        class="sticky top-0 z-30 flex h-12 items-center gap-1.5 border-b border-border bg-card/95 px-3 backdrop-blur sm:px-5"
                    >
                        {if (!props.compact_nav) (
                        <button
                            type="button"
                            onClick="toggle"
                            :aria-expanded="$open"
                            aria-label="Open navigation"
                            class="-ml-1 mr-1 inline-flex size-8 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground lg:hidden"
                        >
                            <Icon name=.menu_03 size={16} />
                        </button>
                        )}
                        <Breadcrumb>
                            <BreadcrumbList>
                                <BreadcrumbItem>
                                    <BreadcrumbLink href="/admin">Dashboard</BreadcrumbLink>
                                </BreadcrumbItem>
                                <BreadcrumbSeparator />
                                <BreadcrumbItem>
                                    <BreadcrumbPage>{props.title}</BreadcrumbPage>
                                </BreadcrumbItem>
                            </BreadcrumbList>
                        </Breadcrumb>
                        <div class="ml-auto flex items-center gap-1.5">
                            <button
                                type="button"
                                onClick="openEnvironment"
                                aria-label="Switch environment"
                                data-p-class="environment|eq|Production->border-success/30+bg-success/10+text-success;environment|eq|Preview->border-primary/30+bg-primary/10+text-primary;environment|eq|Development->border-warning/30+bg-warning/10+text-warning"
                                class="group hidden h-8 cursor-pointer items-center gap-1.5 rounded-md border border-success/30 bg-success/10 px-2.5 text-xs font-semibold text-success transition duration-150 active:translate-y-px sm:inline-flex"
                            >
                                <span
                                    data-p-class="environment|eq|Production->bg-success;environment|eq|Preview->bg-primary;environment|eq|Development->bg-warning"
                                    class="size-1.5 rounded-full bg-success"
                                >

                                </span>
                                <strong :text="$environment" class="font-semibold">Production</strong>
                                <Icon
                                    name=.chevron_down
                                    size={14}
                                    class="size-3.5 opacity-70"
                                />
                            </button>
                            <a
                                href="/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="hidden h-8 items-center gap-1.5 rounded-md px-2 text-xs text-muted-foreground no-underline transition-colors hover:bg-accent hover:text-foreground hover:no-underline md:inline-flex"
                            >
                                View site
                                <Icon name=.external size={14} class="size-3.5" />
                            </a>
                            <button
                                type="button"
                                onClick="openCommand"
                                aria-label="Open command palette"
                                class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground"
                            >
                                <Icon name=.search size={16} class="size-4" />
                            </button>
                            <button
                                type="button"
                                onClick="toggleTheme"
                                aria-label="Toggle theme"
                                class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground"
                            >
                                <Icon
                                    name={IconName.sun}
                                    size={14}
                                    class="theme-toggle-sun hidden dark:block"
                                />
                                <Icon
                                    name={IconName.moon}
                                    size={14}
                                    class="theme-toggle-moon dark:hidden"
                                />
                            </button>
                        </div>
                    </header>
                    <main class="min-h-[calc(100vh-3rem)]">
                        <div
                            class="mx-auto flex max-w-7xl flex-col gap-3 px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4 sm:px-5 sm:pb-[calc(1.25rem+env(safe-area-inset-bottom))] sm:pt-5 lg:px-7 lg:pb-7 lg:pt-7"
                        >
                            {@raw props.content}
                        </div>
                    </main>
                    {if (props.bottom_bar.len > 0) (
                        <div class="border-t border-border px-4 py-2">
                            {@raw props.bottom_bar}
                        </div>
                    )}
                </div>
                <div :showIf="$commandOpen" class="hidden">
                    <div
                        data-publr-component="dialog"
                        data-publr-state="open"
                        class="fixed inset-0 z-[60] flex items-start justify-center bg-black/50 px-4 pt-[12vh]"
                    >
                        <button
                            type="button"
                            data-publr-part="overlay"
                            onClick="closeCommand"
                            aria-label="Close command palette"
                            class="absolute inset-0 h-auto w-auto cursor-default border-0 bg-transparent"
                        >

                        </button>
                        <div
                            data-publr-part="content"
                            role="dialog"
                            aria-modal="true"
                            aria-label="Command palette"
                            class="relative w-full max-w-xl overflow-hidden rounded-lg border border-border bg-popover text-popover-foreground shadow-lg"
                        >
                            <div class="flex h-11 items-center border-b border-border px-3">
                                <Icon
                                    name=.search
                                    size={16}
                                    class="size-4 shrink-0 text-muted-foreground"
                                />
                                <input
                                    type="search"
                                    placeholder="Search content, media, settings…"
                                    data-autofocus
                                    class="h-full min-w-0 flex-1 border-0 bg-transparent px-3 text-sm text-foreground outline-none placeholder:text-muted-foreground"
                                />
                                <kbd
                                    class="rounded border border-border px-1.5 py-0.5 font-mono text-3xs text-muted-foreground"
                                >
                                    ESC
                                </kbd>
                            </div>
                            <div class="p-2">
                                <p
                                    class="px-2 py-1.5 text-3xs font-semibold uppercase tracking-[0.1em] text-muted-foreground"
                                >
                                    Quick actions
                                </p>
                                <a
                                    href="/admin/content"
                                    class="flex w-full items-center gap-2 rounded px-2 py-2.5 text-left text-sm text-foreground no-underline hover:bg-accent hover:no-underline"
                                >
                                    <Icon name=.plus size={16} class="size-4" />
                                    New content
                                </a>
                                <a
                                    href="/admin"
                                    class="flex items-center gap-2 rounded px-2 py-2.5 text-sm text-foreground no-underline hover:bg-accent hover:no-underline"
                                >
                                    <Icon name=.grid size={16} class="size-4" />
                                    Open dashboard
                                </a>
                                <a
                                    href="/admin/media"
                                    class="flex items-center gap-2 rounded px-2 py-2.5 text-sm text-foreground no-underline hover:bg-accent hover:no-underline"
                                >
                                    <Icon name=.image size={16} class="size-4" />
                                    Media library
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <div
                    data-p-show="environmentOpen"
                    onClick="closeEnvironment"
                    class="fixed inset-0 z-40 hidden bg-black/50"
                >

                </div>
                <Drawer
                    open_key="environmentOpen"
                    label="Environment switcher"
                    class="sm:max-w-sm"
                >
                    <DrawerHeader>
                        <span
                            class="inline-flex size-8 shrink-0 items-center justify-center rounded-md bg-muted text-xs font-bold text-foreground"
                        >
                            P
                        </span>
                        <div class="min-w-0 flex-1">
                            <p class="truncate text-sm font-semibold text-foreground">Publr</p>
                            <p class="text-2xs text-muted-foreground">Content space</p>
                        </div>
                        <button
                            type="button"
                            data-drawer-close
                            onClick="closeEnvironment"
                            aria-label="Close environment switcher"
                            class="inline-flex size-8 cursor-pointer items-center justify-center rounded-md border-0 bg-transparent text-muted-foreground hover:bg-accent hover:text-foreground"
                        >
                            <Icon name=.x_close size={16} class="size-4" />
                        </button>
                    </DrawerHeader>
                    <DrawerContent class="p-4">
                        <div class="flex items-center">
                            <h2
                                class="text-xs font-semibold uppercase tracking-[0.08em] text-muted-foreground"
                            >
                                Environments
                            </h2>
                            <span class="ml-auto text-2xs text-muted-foreground">3 available</span>
                        </div>
                        <div class="mt-3 space-y-1.5">
                            <EnvironmentChoice
                                name="Production"
                                description="Public site · protected"
                                icon=.globe
                                tone_bg="bg-success/10"
                                tone_text="text-success"
                                tone_dot="bg-success"
                                selected_class="border-success/40+bg-success/5"
                            />
                            <EnvironmentChoice
                                name="Preview"
                                description="Editorial preview environment"
                                icon=.sync
                                tone_bg="bg-primary/10"
                                tone_text="text-primary"
                                tone_dot="bg-primary"
                                selected_class="border-primary/40+bg-primary/5"
                            />
                            <EnvironmentChoice
                                name="Development"
                                description="Schema and content experiments"
                                icon=.code
                                tone_bg="bg-warning/10"
                                tone_text="text-warning"
                                tone_dot="bg-warning"
                                selected_class="border-warning/40+bg-warning/5"
                            />
                        </div>
                        <div class="mt-6 rounded-lg border border-border bg-muted/30 p-3">
                            <p class="text-xs font-medium text-foreground">Environment isolation</p>
                            <p
                                class="mt-1 text-2xs leading-4 text-muted-foreground"
                            >
                                Content and schema changes stay isolated until they are
                                promoted to Production.
                            </p>
                        </div>
                    </DrawerContent>
                </Drawer>
            </TooltipProvider>
            <ToastRegion />
            <MediaPicker />
            // Single PublrJS bootstrap (runtime + all layout-wide stores);
            // page-scoped stores load with their pages (#147).
            <script type="module" src="/static/scripts/publr-admin.js"></script>
            <script type="module" src="/static/scripts/recompile-bar.js"></script>
        </body>
    </html>
}
