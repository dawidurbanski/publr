const std = @import("std");
const ui = @import("publr_ui");
const MediaPicker = @import("../components/media_picker.zig").MediaPicker;

const ContentTypeNav = struct {
    href: []const u8,
    label: []const u8,
    type_id: []const u8 = "",
};

pub const PluginNav = struct {
    id: []const u8,
    href: []const u8,
    label: []const u8,
    icon: IconName,
};
const Icon = ui.icon.Icon;
const IconName = ui.icon.Name;
const Flex = ui.flex.Flex;
const Stack = ui.stack.Stack;
const Avatar = ui.avatar.Avatar;
const AvatarImage = ui.avatar.AvatarImage;
const ToastRegion = ui.toast.ToastRegion;
const TooltipProvider = ui.tooltip.TooltipProvider;
const DropdownMenu = ui.dropdown.DropdownMenu;
const DropdownMenuTrigger = ui.dropdown.DropdownMenuTrigger;
const DropdownMenuContent = ui.dropdown.DropdownMenuContent;
const DropdownMenuItem = ui.dropdown.DropdownMenuItem;
const DropdownMenuSeparator = ui.dropdown.DropdownMenuSeparator;
const InputGroup = ui.input_group.InputGroup;
const InputGroupInput = ui.input_group.InputGroupInput;
const InputGroupAddon = ui.input_group.InputGroupAddon;

fn SidebarItem(props: struct {
    href: []const u8 = "",
    icon: IconName,
    label: []const u8,
    current: []const u8 = "",
    match: []const u8 = "",
    badge: []const u8 = "",
    submenu: []const u8 = "",
}) {
    // Match exact id, or treat the match prop as a prefix when followed by '.'
    // (so match="content" matches pg.id="content.post", "content.page", etc).
    const is_active = props.match.len > 0 and (
    std.mem.eql(u8, props.current, props.match) or
    (std.mem.startsWith(u8, props.current, props.match) and
    props.current.len > props.match.len and
    props.current[props.match.len] == '.')
    );
    const link_class = if (is_active)
    "flex items-center gap-2.5 py-1 px-2 rounded-sm text-sm font-medium text-foreground bg-gray-500/20 no-underline hover:no-underline"
    else
    "flex items-center gap-2.5 py-1 px-2 rounded-sm text-sm font-medium no-underline hover:bg-gray-500/10 hover:text-foreground hover:no-underline";
    <li>
        <a
            href={props.href}
            class={link_class}
            aria-current={if (is_active) "page" else null}
        >
            <Icon name={props.icon} size={14} class="shrink-0" />
            <span class="flex-1 truncate">{props.label}</span>
            {if (props.submenu.len > 0) (
                <Icon
                    name=.chevron_right
                    size={14}
                    class="shrink-0 text-muted-foreground"
                />
            ) else if (props.badge.len > 0) (
                <span class="ml-auto font-mono text-xs text-muted-foreground">{props.badge}</span>
            )}
        </a>
    </li>
}

fn SubLink(props: struct {
    href: []const u8,
    label: []const u8,
    icon: IconName,
    current: []const u8 = "",
    match: []const u8 = "",
    external: bool = false,
}) {
    const is_active = props.match.len > 0 and std.mem.eql(u8, props.current, props.match);
    const cls = if (is_active)
    "flex items-center gap-2.5 py-1 px-2 rounded-sm text-sm font-medium text-foreground bg-gray-500/20 no-underline hover:no-underline"
    else
    "flex items-center gap-2.5 py-1 px-2 rounded-sm text-sm font-medium no-underline hover:bg-gray-500/10 hover:text-foreground hover:no-underline";
    <li>
        <a
            href={props.href}
            class={cls}
            aria-current={if (is_active) "page" else null}
            target={if (props.external) "_blank" else null}
            rel={if (props.external) "noopener noreferrer" else null}
        >
            <Icon name={props.icon} size={14} class="shrink-0" />
            <span class="flex-1 truncate">{props.label}</span>
            {if (props.external) (
                <Icon
                    name=.share_04
                    size={12}
                    class="shrink-0 text-muted-foreground/60"
                />
            )}
        </a>
    </li>
}

fn SubSectionHeading(props: struct { label: []const u8 }) {
    <div
        class="text-xs font-medium uppercase tracking-wider text-muted-foreground py-1 px-2"
    >
        {props.label}
    </div>
}

fn SubFolder(props: struct {
    label: []const u8,
    count: usize = 0,
    children: []const u8 = "",
}) {
    <li>
        <div class="sidebar-folder-static">
            <div
                class="flex items-center gap-2.5 py-1.5 px-2 text-sm font-medium select-none"
            >
                <Icon name=.folder size={14} class="shrink-0" />
                <span class="flex-1 truncate">{props.label}</span>
                <span class="ml-auto font-mono text-xs text-muted-foreground">{props.count}</span>
            </div>
            <ul
                role="list"
                class="flex flex-col gap-px list-none p-0 m-0 mt-0.5 pl-2"
            >
                {@raw props.children}
            </ul>
        </div>
    </li>
}

pub fn Layout(props: struct {
    title: []const u8,
    content: []const u8,
    csrf_token: []const u8,
    user_gravatar_url: []const u8,
    user_email: []const u8 = "",
    user_name: []const u8 = "",
    current_section: []const u8 = "",
    bottom_bar: []const u8 = "",
    topbar_nav_html: []const u8 = "",
    content_types: []const ContentTypeNav = &.{},
    plugin_pages: []const PluginNav = &.{},
    /// When the user is viewing a specific content type (list or edit) or
    /// `/admin/content?type=<id>`, this is that type's id. Drives sidebar
    /// active state: the matching content-type item lights up.
    active_content_type_id: []const u8 = "",
    /// Active saved-view filter for the Content section sidebar. One of
    /// `"all"`, `"recent"`, `"created_by_me"`, `"updated_by_me"`, or
    /// `"status_<value>"`. Empty when no filter applies.
    active_content_view: []const u8 = "",
}) {
    <!DOCTYPE html>
    <html class="dark h-full">
        <head>
            <meta charset="utf-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1, viewport-fit=cover"
            />
            <title>{props.title} - Publr Admin</title>
            <link rel="icon" type="image/svg+xml" href="/static/logo.svg" />
            <link rel="stylesheet" href="/static/styles/tokens.css" />
            <link rel="stylesheet" href="/static/styles/publr.css" />
            <script>
                {@raw "(function(){var t=localStorage.getItem('publr-theme');if(t==='light')document.documentElement.classList.remove('dark');else if(t==='dark')document.documentElement.classList.add('dark');})();"}
            </script>
        </head>
        <body
            class="admin flex min-h-screen flex-col text-foreground antialiased [scrollbar-color:oklch(0.15_0_0/0.3)_transparent] [scrollbar-width:thin]"
            @store="shell"
            onKeydown.esc.window="close"
        >
            <div @store="local:recompile-bar" class="contents">
                <div :showIf="$visible" class="hidden">
                    <div
                        class="recompile-bar fixed inset-x-0 top-0 z-1200 flex h-9 items-center justify-center gap-3 text-sm text-white [&_a]:font-semibold [&_a]:text-white [&_a]:underline"
                        :class="$normal -> bg-primary; $success -> bg-success; $error -> bg-destructive"
                    >
                        <span :text="$text"></span>
                        <a
                            href="#"
                            class="hidden"
                            :showIf="$hasAction"
                            onClick.prevent="actionClick"
                            :text="$actionLabel"
                        >

                        </a>
                    </div>
                </div>
            </div>
            <span class="hidden pl-96 pt-9" aria-hidden="true"></span>
            <TooltipProvider>
                <div
                    :showIf="$open"
                    onClick="close"
                    class="fixed inset-0 z-40 bg-black/40 lg:hidden hidden"
                    aria-hidden="true"
                >

                </div>
                <aside
                    data-publr-component="admin-sidebar"
                    :class="$open == false -> max-lg:-translate-x-full"
                    onClick="navClose"
                    class="admin-sidebar-safe fixed inset-y-0 left-0 z-50 flex w-70 max-lg:-translate-x-full flex-col border-r border-border bg-background pb-[env(safe-area-inset-bottom)] pt-[env(safe-area-inset-top)] text-foreground transition-transform duration-200 ease-out lg:border-r-0 lg:bg-transparent"
                    aria-label="Admin navigation"
                >
                    <Flex items=.center class="gap-2.5 pt-5 pb-3 px-3.5">
                        <a
                            href="/admin"
                            aria-label="Publr"
                            class="flex items-center gap-2.5 text-foreground no-underline hover:no-underline"
                        >
                            <span
                                class="inline-flex items-center justify-center w-5 h-5 bg-foreground text-background text-xs font-bold leading-none shrink-0"
                            >
                                P
                            </span>
                            <span class="text-sm font-semibold tracking-tight">publr</span>
                        </a>
                        <span
                            class="ml-auto font-mono text-xs text-muted-foreground"
                        >
                            v0.4
                        </span>
                    </Flex>
                    <div class="pt-2.5 pb-3 px-1.5">
                        <InputGroup>
                            <InputGroupInput
                                name="search"
                                placeholder="Search…"
                                has_start_addon={true}
                                class="bg-muted py-1.5 pl-7 pr-2.5 text-xs focus-visible:ring-1"
                            />
                            <InputGroupAddon class="pl-2.5">
                                <Icon
                                    name=.search
                                    size={13}
                                    class="text-muted-foreground/50"
                                />
                            </InputGroupAddon>
                        </InputGroup>
                    </div>
                    <nav
                        class="flex-1 overflow-y-auto px-1.5"
                        data-publr-sidebar-nav
                    >
                        <div
                            data-publr-sidebar-panel="main"
                            class={if (std.mem.eql(u8, props.current_section, "content") or std.mem.startsWith(u8, props.current_section, "content.")) "hidden" else ""}
                        >
                            <ul
                                role="list"
                                class="flex flex-col gap-px list-none p-0 m-0"
                            >
                                <SidebarItem
                                    href="/admin"
                                    icon=.home
                                    label="Dashboard"
                                    current={props.current_section}
                                    match="dashboard"
                                />
                                <SidebarItem
                                    href="/admin/content"
                                    icon=.bookmark
                                    label="Content"
                                    current={props.current_section}
                                    match="content"
                                    submenu="content"
                                />
                                <SidebarItem
                                    href="/admin/releases"
                                    icon=.copy
                                    label="Releases"
                                    current={props.current_section}
                                    match="releases"
                                />
                                <SidebarItem
                                    href="/admin/content-types"
                                    icon=.package
                                    label="Content Types"
                                    current={props.current_section}
                                    match="content_types"
                                />
                                <SidebarItem
                                    href="/admin/media"
                                    icon=.image
                                    label="Media"
                                    current={props.current_section}
                                    match="media"
                                />
                            </ul>
                            <div class="h-3.5"></div>
                            <div
                                class="text-xs font-medium uppercase tracking-wider text-muted-foreground py-1 px-2"
                            >
                                System
                            </div>
                            <ul
                                role="list"
                                class="flex flex-col gap-px list-none p-0 m-0"
                            >
                                <SidebarItem
                                    href="/admin/settings"
                                    icon=.settings
                                    label="Settings"
                                    current={props.current_section}
                                    match="settings"
                                />
                            </ul>
                            {if (props.plugin_pages.len > 0) (
                                <div class="h-3.5"></div>
                                <div
                                    class="text-xs font-medium uppercase tracking-wider text-muted-foreground py-1 px-2"
                                >
                                    Plugins
                                </div>
                                <ul
                                    role="list"
                                    class="flex flex-col gap-px list-none p-0 m-0"
                                >
                                    {for (props.plugin_pages) |p| (
                                        <SidebarItem
                                            href={p.href}
                                            icon={p.icon}
                                            label={p.label}
                                            current={props.current_section}
                                            match={p.id}
                                        />
                                    )}
                                </ul>
                            )}
                        </div>
                        <div
                            data-publr-sidebar-panel="content"
                            class={if (std.mem.eql(u8, props.current_section, "content") or std.mem.startsWith(u8, props.current_section, "content.")) "" else "hidden"}
                        >
                            <a
                                href="/admin"
                                class="flex items-center gap-2.5 py-1.5 px-2 w-full text-left bg-transparent border-0 rounded-sm text-sm font-semibold text-foreground hover:bg-gray-500/10 cursor-pointer no-underline"
                            >
                                <Icon
                                    name=.chevron_left
                                    size={14}
                                    class="shrink-0"
                                />
                                <span class="flex-1 truncate">Content</span>
                            </a>
                            <ul
                                role="list"
                                class="flex flex-col gap-px list-none p-0 m-0 mt-1"
                            >
                                <SubLink
                                    href="/admin/content"
                                    icon=.menu_03
                                    label="All content"
                                    current={props.active_content_view}
                                    match="all"
                                />
                                <SubLink
                                    href="/admin/content?recent=1"
                                    icon=.clock_rewind
                                    label="Recent"
                                    current={props.active_content_view}
                                    match="recent"
                                />
                                <SubLink
                                    href="#"
                                    icon=.clock_check
                                    label="Scheduled"
                                />
                                <SubLink
                                    href="/admin/releases"
                                    icon=.calendar_check
                                    label="Releases"
                                    external={true}
                                />
                            </ul>
                            <hr class="my-3 border-gray-500/30" />
                            <SubSectionHeading label="My views" />
                            <ul
                                role="list"
                                class="flex flex-col gap-px list-none p-0 m-0"
                            >
                                <SubLink
                                    href="/admin/content?author=me"
                                    icon=.bookmark
                                    label="Created by me"
                                    current={props.active_content_view}
                                    match="created_by_me"
                                />
                                <SubLink
                                    href="/admin/content?editor=me"
                                    icon=.bookmark
                                    label="Updated by me"
                                    current={props.active_content_view}
                                    match="updated_by_me"
                                />
                            </ul>
                            <hr class="my-3 border-gray-500/30" />
                            <SubSectionHeading label="Views" />
                            <ul
                                role="list"
                                class="flex flex-col gap-px list-none p-0 m-0"
                            >
                                <SubLink
                                    href="/admin/content"
                                    icon=.menu_03
                                    label="All"
                                    current={props.active_content_view}
                                    match="all"
                                />
                                <SubFolder label="Status" count={4}>
                                    <SubLink
                                        href="/admin/content?status=published"
                                        icon=.bookmark
                                        label="Published"
                                        current={props.active_content_view}
                                        match="status_published"
                                    />
                                    <SubLink
                                        href="/admin/content?status=changed"
                                        icon=.bookmark
                                        label="Changed"
                                        current={props.active_content_view}
                                        match="status_changed"
                                    />
                                    <SubLink
                                        href="/admin/content?status=draft"
                                        icon=.bookmark
                                        label="Draft"
                                        current={props.active_content_view}
                                        match="status_draft"
                                    />
                                    <SubLink
                                        href="/admin/content?status=archived"
                                        icon=.bookmark
                                        label="Archived"
                                        current={props.active_content_view}
                                        match="status_archived"
                                    />
                                </SubFolder>
                                <SubFolder
                                    label="Content type"
                                    count={props.content_types.len}
                                >
                                    {for (props.content_types) |ct| (
                                        <SubLink
                                            href={ct.href}
                                            icon=.bookmark
                                            label={ct.label}
                                            current={props.active_content_type_id}
                                            match={ct.type_id}
                                        />
                                    )}
                                </SubFolder>
                            </ul>
                        </div>
                    </nav>
                    <Flex items=.center class="mt-auto gap-2.5 p-2.5">
                        <Avatar>
                            <AvatarImage
                                src={props.user_gravatar_url}
                                alt=""
                                class=""
                            />
                        </Avatar>
                        <Stack gap=.none class="min-w-0 flex-1">
                            {if (props.user_name.len > 0) (
                                <span
                                    class="text-xs font-medium text-foreground truncate"
                                >
                                    {props.user_name}
                                </span>
                                <span
                                    class="text-xs text-muted-foreground truncate"
                                >
                                    {props.user_email}
                                </span>
                            ) else (
                                <span
                                    class="text-xs font-medium text-foreground truncate"
                                >
                                    {props.user_email}
                                </span>
                            )}
                        </Stack>
                        <form
                            method="POST"
                            action="/admin/logout"
                            class="shrink-0 inline-flex"
                        >
                            <input
                                type="hidden"
                                name="_csrf"
                                value={props.csrf_token}
                            />
                            <button
                                type="submit"
                                class="inline-flex items-center justify-center bg-transparent border-0 p-0 text-muted-foreground opacity-60 hover:opacity-100 cursor-pointer"
                                aria-label="Logout"
                            >
                                <Icon name=.logout size={13} />
                            </button>
                        </form>
                    </Flex>
                </aside>
                <div
                    class="admin-shell h-dvh pl-[max(0.375rem,env(safe-area-inset-left))] lg:pl-[max(17.5rem,env(safe-area-inset-left))]"
                >
                    <div
                        class="admin-card flex h-full flex-col overflow-hidden rounded-xl border border-border bg-background shadow-xs"
                    >
                        <header
                            class="sticky top-0 z-40 h-12 shrink-0 flex items-center gap-2 sm:gap-3 border-b border-border px-3 sm:px-4 lg:px-6"
                        >
                            <button
                                type="button"
                                onClick="toggle"
                                :aria-expanded="$open"
                                aria-label="Open navigation"
                                class="lg:hidden inline-flex items-center justify-center bg-transparent border-0 p-1.5 -ml-1 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                            >
                                <Icon name=.menu_03 size={16} />
                            </button>
                            <span
                                class="flex-1 min-w-0 text-xs text-muted-foreground truncate"
                            >
                                {props.title}
                            </span>
                            <Flex
                                items=.center
                                class="hidden sm:flex gap-1.5 text-xs text-muted-foreground"
                            >
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-success inline-block"
                                >

                                </span>
                                <span>Saved</span>
                            </Flex>
                            <button
                                type="button"
                                onClick="toggleTheme"
                                aria-label="Toggle theme"
                                class="ml-1.5 inline-flex items-center justify-center bg-transparent border-0 p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                            >
                                <Icon
                                    name={IconName.sun}
                                    size={14}
                                    class="theme-toggle-sun hidden dark:block"
                                />
                                <Icon
                                    name={IconName.moon}
                                    size={14}
                                    class="theme-toggle-moon dark:hidden"
                                />
                            </button>
                        </header>
                        <main class="flex-1 overflow-auto">
                            <div
                                class="admin-content-pad mx-auto flex max-w-7xl flex-col gap-3 px-4 pb-[calc(1rem+env(safe-area-inset-bottom))] pt-4 sm:px-5 sm:pb-[calc(1.25rem+env(safe-area-inset-bottom))] sm:pt-5 lg:px-7 lg:pb-7 lg:pt-7"
                            >
                                {@raw props.content}
                            </div>
                        </main>
                    </div>
                </div>
                {if (props.bottom_bar.len > 0) (
                    <div class="border-t border-border px-4 py-2">
                        {@raw props.bottom_bar}
                    </div>
                )}
            </TooltipProvider>
            <ToastRegion />
            <MediaPicker />
            // Single PublrJS bootstrap (runtime + all layout-wide stores);
            // page-scoped stores load with their pages (#147).
            <script type="module" src="/static/scripts/publr-admin.js"></script>
            <script type="module" src="/static/scripts/recompile-bar.js"></script>
        </body>
    </html>
}
