// Post edit template — split into content + sidebar for edit layout

const ui = @import("publr_ui");
const Button = ui.button.Button;
const Field = ui.form_field.Field;
const FieldLabel = ui.form_field.FieldLabel;
const Input = ui.text_input.Input;
const Flex = ui.flex.Flex;
const Text = ui.text.Text;
const Stack = ui.stack.Stack;
const Heading = ui.heading.Heading;

const PostData = struct {
    title: []const u8,
    slug: []const u8,
    content: []const u8,
    date: []const u8,
    status: []const u8,
    is_draft: bool,
    is_published: bool,
    is_changed: bool,
    featured_image: []const u8,
    featured_image_url: []const u8,
    entry_id: []const u8,
    published_data: []const u8,
};

/// Main editor content (left side)
pub fn Edit(props: struct {
    post: PostData,
    csrf_token: []const u8,
    action: []const u8 = "",
    fields_in_releases: []const u8 = "[]",
    field_editors: []const u8 = "{}",
}) {
    <form
        method="POST"
        action={props.action}
        id="entry-form"
        class="form w-full"
        data-base-url="/admin/posts"
        data-entry-id={props.post.entry_id}
        data-entry-status={props.post.status}
        data-published-state={props.post.published_data}
        data-fields-in-releases={props.fields_in_releases}
        data-field-editors={props.field_editors}
    >
        <input type="hidden" name="_csrf" value={props.csrf_token} />
        <input type="hidden" name="fields" value="" id="publish-fields" />
        <div class="form-group mb-5" data-field="title">
            <div
                class="form-label-row mb-1 flex items-center justify-between gap-2"
            >
                <FieldLabel html_for="title">Title</FieldLabel>
                <div class="field-check-row flex items-center gap-2">
                    <span
                        class="field-editor-badge hidden items-center gap-1 whitespace-nowrap text-xs text-muted-foreground [.form-group.field-changed_&.field-editor-active]:flex [.form-group.field-deselected_&.field-editor-active]:flex [.form-group.field-in-release_&.field-editor-active]:flex"
                        data-field="title"
                    >

                    </span>
                    <label
                        class="switch-label field-publish-switch hidden cursor-pointer items-center gap-2 text-sm [.form-group.field-changed_&]:inline-flex [.form-group.field-deselected_&]:inline-flex"
                    >
                        <input type="checkbox" class="switch-input field-publish-check peer absolute h-0 w-0 opacity-0" data-field="title" checked="" /><span class="switch-track relative inline-block h-5 w-9 rounded-full bg-input transition-colors peer-checked:bg-primary peer-checked:[&_.switch-thumb]:translate-x-4" role="switch" aria-checked="true"><span class="switch-thumb absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white transition-transform"></span></span>
                    </label>
                </div>
            </div>
            <Input
                input_type=.text
                name="title"
                value={props.post.title}
                required={true}
            />
        </div>
        <div class="form-group mb-5" data-field="slug">
            <div
                class="form-label-row mb-1 flex items-center justify-between gap-2"
            >
                <FieldLabel html_for="slug">Slug</FieldLabel>
                <div class="field-check-row flex items-center gap-2">
                    <span
                        class="field-editor-badge hidden items-center gap-1 whitespace-nowrap text-xs text-muted-foreground [.form-group.field-changed_&.field-editor-active]:flex [.form-group.field-deselected_&.field-editor-active]:flex [.form-group.field-in-release_&.field-editor-active]:flex"
                        data-field="slug"
                    >

                    </span>
                    <label
                        class="switch-label field-publish-switch hidden cursor-pointer items-center gap-2 text-sm [.form-group.field-changed_&]:inline-flex [.form-group.field-deselected_&]:inline-flex"
                    >
                        <input type="checkbox" class="switch-input field-publish-check peer absolute h-0 w-0 opacity-0" data-field="slug" checked="" /><span class="switch-track relative inline-block h-5 w-9 rounded-full bg-input transition-colors peer-checked:bg-primary peer-checked:[&_.switch-thumb]:translate-x-4" role="switch" aria-checked="true"><span class="switch-thumb absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white transition-transform"></span></span>
                    </label>
                </div>
            </div>
            <Input
                input_type=.text
                name="slug"
                value={props.post.slug}
            />
        </div>
        <div class="form-group mb-5" data-field="body">
            <div
                class="form-label-row mb-1 flex items-center justify-between gap-2"
            >
                <FieldLabel html_for="content">Content</FieldLabel>
                <div class="field-check-row flex items-center gap-2">
                    <span
                        class="field-editor-badge hidden items-center gap-1 whitespace-nowrap text-xs text-muted-foreground [.form-group.field-changed_&.field-editor-active]:flex [.form-group.field-deselected_&.field-editor-active]:flex [.form-group.field-in-release_&.field-editor-active]:flex"
                        data-field="body"
                    >

                    </span>
                    <label
                        class="switch-label field-publish-switch hidden cursor-pointer items-center gap-2 text-sm [.form-group.field-changed_&]:inline-flex [.form-group.field-deselected_&]:inline-flex"
                    >
                        <input type="checkbox" class="switch-input field-publish-check peer absolute h-0 w-0 opacity-0" data-field="body" checked="" /><span class="switch-track relative inline-block h-5 w-9 rounded-full bg-input transition-colors peer-checked:bg-primary peer-checked:[&_.switch-thumb]:translate-x-4" role="switch" aria-checked="true"><span class="switch-thumb absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-white transition-transform"></span></span>
                    </label>
                </div>
            </div>
            <textarea
                id="content"
                name="content"
                class="form-control min-h-32 w-full resize-y rounded-[calc(var(--radius)*0.8)] border border-input bg-background px-3 py-2 text-base leading-6 text-foreground placeholder:text-muted-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background sm:text-sm"
                rows="12"
            >{props.post.content}</textarea>
        </div>
    </form>
}

/// Right sidebar (status, metadata, actions)
pub fn EditSidebar(props: struct {
    post: PostData,
    csrf_token: []const u8,
    delete_url: []const u8 = "",
    history_html: []const u8 = "",
    release_html: []const u8 = "",
}) {
    <div class="p-4 border-b border-border">
        <Stack gap=.sm>
            <div
                class="autosave-status min-h-[1.125rem] text-center text-xs leading-[1.125rem]"
                id="autosave-status"
            ></div>
            {if (props.post.is_draft) (
                <button
                    type="submit"
                    form="entry-form"
                    name="status"
                    value="published"
                    class="btn btn-primary btn-full inline-flex w-full cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-primary bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90"
                    id="publish-btn"
                >
                    Publish
                </button>
            ) else if (props.post.is_changed) (
                <button
                    type="submit"
                    form="entry-form"
                    name="status"
                    value="published"
                    class="btn btn-primary btn-full inline-flex w-full cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-primary bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground shadow-xs hover:opacity-90"
                    id="publish-btn"
                >
                    Publish Changes
                </button>
            ) else (
                <button
                    type="submit"
                    form="entry-form"
                    name="status"
                    value="published"
                    class="btn btn-primary btn-full inline-flex w-full cursor-not-allowed items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-primary bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground opacity-50 shadow-xs"
                    id="publish-btn"
                    disabled=""
                >
                    Published
                </button>
            )}
            {if (!props.post.is_draft) (
                <button
                    type="button"
                    class={if (props.post.is_changed) "btn btn-ghost btn-full inline-flex w-full cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-2 text-sm font-semibold text-secondary-foreground hover:bg-accent" else "btn btn-ghost btn-full hidden w-full cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-2 text-sm font-semibold text-secondary-foreground hover:bg-accent"}
                    id="discard-btn"
                >
                    Discard Changes
                </button>
            )}
            {if (props.release_html.len > 0) (
                {@raw props.release_html}
            )}
        </Stack>
    </div>
    <div class="p-4 border-b border-border">
        <Heading level=.h3 size=.xs>Details</Heading>
        <Stack gap=.sm>
            <Text size=.sm color=.muted as=.span>Publish Date</Text>
            <input
                type="date"
                id="date"
                name="date"
                value={props.post.date}
                class="form-control w-full cursor-pointer rounded-[calc(var(--radius)*0.8)] border border-input bg-background px-3 py-2 text-base leading-6 text-foreground focus:border-ring focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2 focus:ring-offset-background sm:text-sm"
                form="entry-form"
            />
        </Stack>
    </div>
    <div class="p-4 border-b border-border">
        <Heading level=.h3 size=.xs>Featured Image</Heading>
        <Stack gap=.sm>
            {if (props.post.featured_image.len > 0) (
                <div
                    @store="local:image-field"
                    class="image-picker overflow-hidden rounded-[calc(var(--radius)*0.8)] border border-border bg-muted"
                    data-publr-state="selected"
                    data-publr-accept="image/*"
                >
                    <input
                        type="hidden"
                        name="featured_image"
                        value={props.post.featured_image}
                        data-publr-part="value"
                        form="entry-form"
                    />
                    <div
                        class="image-picker-preview flex min-h-[120px] items-center justify-center border-b border-border bg-muted"
                        data-publr-part="preview"
                    >
                        <img
                            src={props.post.featured_image_url}
                            alt=""
                            class="image-picker-thumb block max-h-[200px] max-w-full object-contain"
                        />
                    </div>
                    <div class="image-picker-actions flex gap-2 bg-muted p-3">
                        <button
                            type="button"
                            class="btn btn-sm inline-flex cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-input bg-secondary px-3 py-1.5 text-sm font-semibold text-secondary-foreground shadow-xs hover:bg-accent"
                            data-publr-part="trigger"
                            onClick="pick"
                        >
                            Change Image
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-ghost inline-flex cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-1.5 text-sm font-semibold text-secondary-foreground hover:bg-accent"
                            data-publr-part="remove"
                            onClick="clear"
                        >
                            Remove
                        </button>
                    </div>
                    <div
                        class="image-picker-alt empty:hidden px-3 pb-3 text-sm text-muted-foreground"
                        data-publr-part="alt"
                    ></div>
                </div>
            ) else (
                <div
                    @store="local:image-field"
                    class="image-picker overflow-hidden rounded-[calc(var(--radius)*0.8)] border border-border bg-muted"
                    data-publr-state="empty"
                    data-publr-accept="image/*"
                >
                    <input
                        type="hidden"
                        name="featured_image"
                        value=""
                        data-publr-part="value"
                        form="entry-form"
                    />
                    <div
                        class="image-picker-preview flex min-h-[120px] items-center justify-center border-b border-border bg-muted"
                        data-publr-part="preview"
                    >
                        <div
                            class="image-picker-placeholder flex flex-col items-center gap-2 p-4 text-muted-foreground"
                        >
                            <svg
                                class="icon h-8 w-8 opacity-50"
                                viewBox="0 0 24 24"
                                fill="none"
                            >
                                <path d="M4 16L8.58579 11.4142C9.36683 10.6332 10.6332 10.6332 11.4142 11.4142L16 16M14 14L15.5858 12.4142C16.3668 11.6332 17.6332 11.6332 18.4142 12.4142L20 14M14 8H14.01M6 20H18C19.1046 20 20 19.1046 20 18V6C20 4.89543 19.1046 4 18 4H6C4.89543 4 4 4.89543 4 6V18C4 19.1046 4.89543 20 6 20Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                            <span class="text-sm">No image selected</span>
                        </div>
                    </div>
                    <div class="image-picker-actions flex gap-2 bg-muted p-3">
                        <button
                            type="button"
                            class="btn btn-sm inline-flex cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-input bg-secondary px-3 py-1.5 text-sm font-semibold text-secondary-foreground shadow-xs hover:bg-accent"
                            data-publr-part="trigger"
                            onClick="pick"
                        >
                            Select Image
                        </button>
                        <button
                            type="button"
                            class="btn btn-sm btn-ghost hidden cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-transparent bg-transparent px-3 py-1.5 text-sm font-semibold text-secondary-foreground hover:bg-accent"
                            data-publr-part="remove"
                            onClick="clear"
                        >
                            Remove
                        </button>
                    </div>
                    <div
                        class="image-picker-alt empty:hidden px-3 pb-3 text-sm text-muted-foreground"
                        data-publr-part="alt"
                    ></div>
                </div>
            )}
        </Stack>
    </div>
    {if (props.history_html.len > 0) (
        {@raw props.history_html}
    )}
    {if (props.delete_url.len > 0) (
        <div class="p-4 mt-auto">
            <form
                method="POST"
                action={props.delete_url}
                onsubmit="return confirm('Delete this post permanently?')"
            >
                <input type="hidden" name="_csrf" value={props.csrf_token} />
                <button
                    type="submit"
                    class="btn btn-danger btn-sm btn-full inline-flex w-full cursor-pointer items-center justify-center rounded-[calc(var(--radius)*0.8)] border border-destructive bg-destructive px-3 py-1.5 text-sm font-semibold text-primary-foreground hover:opacity-90"
                >
                    Delete Post
                </button>
            </form>
        </div>
    )}
}
