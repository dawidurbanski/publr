// Edit layout — dashboard chrome (admin-shell + admin-card), no left sidebar.
// The card splits into a wide editor on the left and a metadata sidebar on the right.

const ui = @import("publr_ui");
const MediaPicker = @import("../components/media_picker.zig").MediaPicker;
const Icon = ui.icon.Icon;
const IconName = ui.icon.Name;
const Flex = ui.flex.Flex;
const ToastRegion = ui.toast.ToastRegion;
const TooltipProvider = ui.tooltip.TooltipProvider;
const Breadcrumb = ui.breadcrumbs.Breadcrumb;
const BreadcrumbList = ui.breadcrumbs.BreadcrumbList;
const BreadcrumbItem = ui.breadcrumbs.BreadcrumbItem;
const BreadcrumbLink = ui.breadcrumbs.BreadcrumbLink;
const BreadcrumbPage = ui.breadcrumbs.BreadcrumbPage;
const BreadcrumbSeparator = ui.breadcrumbs.BreadcrumbSeparator;

pub fn LayoutEdit(props: struct {
    title: []const u8,
    content: []const u8,
    topbar_nav_html: []const u8,
    csrf_token: []const u8,
    user_gravatar_url: []const u8,
    back_url: []const u8,
    sidebar: []const u8 = "",
    content_type_label: []const u8 = "",
    content_type_url: []const u8 = "",
    content_type_icon: IconName = .bookmark,
}) {
    <!DOCTYPE html>
    <html class="dark h-full">
        <head>
            <meta charset="utf-8" />
            <meta
                name="viewport"
                content="width=device-width, initial-scale=1, viewport-fit=cover"
            />
            <title>{props.title} - Publr Admin</title>
            <link rel="icon" type="image/svg+xml" href="/static/logo.svg" />
            <link rel="stylesheet" href="/static/styles/tokens.css" />
            <link rel="stylesheet" href="/static/styles/publr.css" />
            <script>
                {@raw "(function(){var t=localStorage.getItem('publr-theme');if(t==='light')document.documentElement.classList.remove('dark');else if(t==='dark')document.documentElement.classList.add('dark');})();"}
            </script>
        </head>
        <body
            class="admin flex min-h-screen flex-col text-foreground antialiased [scrollbar-color:oklch(0.15_0_0/0.3)_transparent] [scrollbar-width:thin]"
            @store="shell"
        >
            // Utilities applied by entry-editor.js and presence.js to DOM
            // nodes they create at runtime; keeping them in rendered source
            // makes them visible to the production JIT class scan.
            <span
                class="hidden group/takeover group-hover/takeover:invisible group-hover/takeover:flex opacity-40 opacity-60 outline outline-[3px] outline-transparent outline-warning outline-input outline-primary transition-[outline-color] pr-9 translate-y-0 -translate-y-1/2 [&.field-changed]:outline-warning [&.field-deselected]:outline-input [&.field-in-release]:outline-primary [.field-wrapper.field-changed_&]:flex [.field-wrapper.field-deselected_&]:flex [.field-wrapper:has(textarea)_&]:top-3 [.field-wrapper:has(textarea)_&]:translate-y-0 [&_svg]:h-4 [&_svg]:w-4"
                aria-hidden="true"
            >

            </span>
            <TooltipProvider>
                <div
                    class="admin-shell admin-shell--flush h-dvh pl-[max(0.375rem,env(safe-area-inset-left))]"
                >
                    <div
                        class="admin-card flex h-full flex-col overflow-hidden rounded-xl border border-border bg-background shadow-xs"
                    >
                        <header
                            class="sticky top-0 z-40 h-12 shrink-0 flex items-center gap-2 sm:gap-3 border-b border-border px-3 sm:px-4 lg:px-6"
                        >
                            <a
                                href={props.back_url}
                                class="inline-flex items-center justify-center p-1.5 -ml-1 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground no-underline"
                                aria-label="Back"
                            >
                                <Icon name={IconName.arrow_left} size={16} />
                            </a>
                            <div class="flex-1 min-w-0">
                                {if (props.content_type_label.len > 0) (
                                    <Breadcrumb>
                                        <BreadcrumbList>
                                            <BreadcrumbItem>
                                                <BreadcrumbLink
                                                    href={props.content_type_url}
                                                    class="inline-flex items-center gap-1.5"
                                                >
                                                    <Icon
                                                        name={props.content_type_icon}
                                                        size={14}
                                                        class="shrink-0"
                                                    />
                                                    {props.content_type_label}
                                                </BreadcrumbLink>
                                            </BreadcrumbItem>
                                            <BreadcrumbSeparator />
                                            <BreadcrumbItem>
                                                <BreadcrumbPage
                                                    class="truncate"
                                                >
                                                    {props.title}
                                                </BreadcrumbPage>
                                            </BreadcrumbItem>
                                        </BreadcrumbList>
                                    </Breadcrumb>
                                ) else (
                                    <span
                                        class="text-sm font-medium text-foreground truncate"
                                    >
                                        {props.title}
                                    </span>
                                )}
                            </div>
                            <PresenceUsers />
                            <Flex
                                items=.center
                                class="hidden sm:flex gap-1.5 text-xs text-muted-foreground"
                            >
                                <span
                                    class="w-1.5 h-1.5 rounded-full bg-success inline-block"
                                >

                                </span>
                                <span>Saved</span>
                            </Flex>
                            <button
                                type="button"
                                onClick="toggleTheme"
                                aria-label="Toggle theme"
                                class="ml-1.5 inline-flex items-center justify-center bg-transparent border-0 p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                            >
                                <Icon
                                    name={IconName.sun}
                                    size={14}
                                    class="theme-toggle-sun hidden dark:block"
                                />
                                <Icon
                                    name={IconName.moon}
                                    size={14}
                                    class="theme-toggle-moon dark:hidden"
                                />
                            </button>
                        </header>
                        <div
                            class="flex-1 min-h-0 flex flex-col lg:flex-row lg:overflow-hidden overflow-y-auto"
                            @store="local:entry-editor"
                        >
                            <main class="flex-1 min-w-0 lg:overflow-y-auto">
                                <div
                                    class="max-w-3xl mx-auto px-5 sm:px-7 lg:px-10 py-6 lg:py-8"
                                >
                                    {@raw props.content}
                                </div>
                            </main>
                            <aside
                                class="w-full lg:w-80 shrink-0 border-t lg:border-t-0 lg:border-l border-border bg-background/40 lg:overflow-y-auto flex flex-col"
                            >
                                {@raw props.sidebar}
                            </aside>
                        </div>
                    </div>
                </div>
            </TooltipProvider>
            <ToastRegion />
            <MediaPicker />
            // Single PublrJS bootstrap (runtime + all layout-wide stores);
            // page-scoped stores load with their pages (#147).
            <script type="module" src="/static/scripts/publr-admin.js"></script>
            <script type="module" src="/static/scripts/entry-editor.js"></script>
        </body>
    </html>
}
