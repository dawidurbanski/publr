// Edit layout — dashboard chrome (admin-shell + admin-card), no left sidebar.
// The card splits into a wide editor on the left and a metadata sidebar on the right.

const ui = @import("publr_ui");
const Icon = ui.icon.Icon;
const IconName = ui.icon.Name;
const Flex = ui.flex.Flex;
const ToastRegion = ui.toast.ToastRegion;
const TooltipProvider = ui.tooltip.TooltipProvider;
const Breadcrumb = ui.breadcrumbs.Breadcrumb;
const BreadcrumbList = ui.breadcrumbs.BreadcrumbList;
const BreadcrumbItem = ui.breadcrumbs.BreadcrumbItem;
const BreadcrumbLink = ui.breadcrumbs.BreadcrumbLink;
const BreadcrumbPage = ui.breadcrumbs.BreadcrumbPage;
const BreadcrumbSeparator = ui.breadcrumbs.BreadcrumbSeparator;

pub fn LayoutEdit(props: struct {
    title: []const u8,
    content: []const u8,
    topbar_nav_html: []const u8,
    csrf_token: []const u8,
    user_gravatar_url: []const u8,
    back_url: []const u8,
    sidebar: []const u8 = "",
    content_type_label: []const u8 = "",
    content_type_url: []const u8 = "",
    content_type_icon: IconName = .bookmark,
}) {
    <!DOCTYPE html>
    <html class="dark h-full">
        <head>
            <meta charset="utf-8" />
            <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
            <title>{props.title} - Publr Admin</title>
            <link rel="icon" type="image/svg+xml" href="/static/logo.svg" />
            <link rel="stylesheet" href="/static/tokens.css" />
            <link rel="stylesheet" href="/static/publr.css" />
            <link rel="stylesheet" href="/static/admin.css" />
            <style>{@raw ".theme-toggle-sun{display:none}.dark .theme-toggle-sun{display:block}.dark .theme-toggle-moon{display:none}"}</style>
            <style>{@raw ":root{--admin-shell-bg:radial-gradient(ellipse 70% 65% at 10% 10%, rgba(181,207,210,0.45) 0%, transparent 70%),radial-gradient(ellipse 55% 55% at 45% 8%, rgba(197,204,184,0.35) 0%, transparent 70%),radial-gradient(ellipse 65% 60% at 85% 12%, rgba(224,207,163,0.5) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 80% 45%, rgba(221,208,171,0.4) 0%, transparent 70%),radial-gradient(ellipse 50% 45% at 50% 50%, rgba(200,196,168,0.3) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 15% 45%, rgba(168,191,194,0.4) 0%, transparent 70%),radial-gradient(ellipse 55% 50% at 12% 88%, rgba(184,176,138,0.4) 0%, transparent 70%),radial-gradient(ellipse 50% 45% at 45% 90%, rgba(200,192,160,0.3) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 82% 85%, rgba(213,207,192,0.35) 0%, transparent 70%),radial-gradient(ellipse 35% 35% at 70% 25%, rgba(237,220,184,0.35) 0%, transparent 65%),#f6f4f1;}.dark{--admin-shell-bg:radial-gradient(ellipse 70% 65% at 10% 10%, rgba(40,65,68,0.5) 0%, transparent 70%),radial-gradient(ellipse 55% 55% at 45% 8%, rgba(50,55,42,0.4) 0%, transparent 70%),radial-gradient(ellipse 65% 60% at 85% 12%, rgba(80,65,35,0.5) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 80% 45%, rgba(70,58,30,0.45) 0%, transparent 70%),radial-gradient(ellipse 50% 45% at 50% 50%, rgba(55,52,38,0.35) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 15% 45%, rgba(35,55,58,0.45) 0%, transparent 70%),radial-gradient(ellipse 55% 50% at 12% 88%, rgba(50,46,28,0.45) 0%, transparent 70%),radial-gradient(ellipse 50% 45% at 45% 90%, rgba(45,42,30,0.35) 0%, transparent 70%),radial-gradient(ellipse 50% 50% at 82% 85%, rgba(48,44,35,0.4) 0%, transparent 70%),radial-gradient(ellipse 35% 35% at 70% 25%, rgba(90,72,35,0.4) 0%, transparent 65%),#141310;}body.admin{background:var(--admin-shell-bg)}.admin-shell{padding-top:max(0.375rem,env(safe-area-inset-top));padding-bottom:max(0.375rem,env(safe-area-inset-bottom));padding-right:max(0.375rem,env(safe-area-inset-right));padding-left:max(0.375rem,env(safe-area-inset-left));height:100dvh;}.admin-card{border-top-left-radius:0.75rem;border-top-right-radius:0.75rem;border-bottom-left-radius:var(--device-corner-radius,0.75rem);border-bottom-right-radius:var(--device-corner-radius,0.75rem);}"}</style>
            <script>
                {@raw "(function(){var t=localStorage.getItem('publr-theme');if(t==='light')document.documentElement.classList.remove('dark');else if(t==='dark')document.documentElement.classList.add('dark');})();"}
            </script>
        </head>
        <body class="h-full text-foreground admin" @store="shell">
            <TooltipProvider>
                <div class="admin-shell">
                    <div class="admin-card h-full flex flex-col bg-background border border-border shadow-xs overflow-hidden">
                        <header class="sticky top-0 z-40 h-12 shrink-0 flex items-center gap-2 sm:gap-3 border-b border-border px-3 sm:px-4 lg:px-6">
                            <a href={props.back_url}
                               class="inline-flex items-center justify-center p-1.5 -ml-1 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground no-underline"
                               aria-label="Back">
                                <Icon name={IconName.arrow_left} size={16} />
                            </a>
                            <div class="flex-1 min-w-0">
                                {if (props.content_type_label.len > 0) (
                                    <Breadcrumb>
                                        <BreadcrumbList>
                                            <BreadcrumbItem>
                                                <BreadcrumbLink href={props.content_type_url} class="inline-flex items-center gap-1.5">
                                                    <Icon name={props.content_type_icon} size={14} class="shrink-0" />
                                                    {props.content_type_label}
                                                </BreadcrumbLink>
                                            </BreadcrumbItem>
                                            <BreadcrumbSeparator />
                                            <BreadcrumbItem>
                                                <BreadcrumbPage class="truncate">{props.title}</BreadcrumbPage>
                                            </BreadcrumbItem>
                                        </BreadcrumbList>
                                    </Breadcrumb>
                                ) else (
                                    <span class="text-sm font-medium text-foreground truncate">{props.title}</span>
                                )}
                            </div>
                            <div id="presence-users" class="flex items-center"></div>
                            <Flex items=.center class="hidden sm:flex gap-1.5 text-xs text-muted-foreground">
                                <span class="w-1.5 h-1.5 rounded-full bg-success inline-block"></span>
                                <span>Saved</span>
                            </Flex>
                            <button
                                type="button"
                                onClick="toggleTheme"
                                aria-label="Toggle theme"
                                class="ml-1.5 inline-flex items-center justify-center bg-transparent border-0 p-1.5 rounded-md text-muted-foreground hover:bg-accent hover:text-foreground cursor-pointer"
                            >
                                <Icon name={IconName.sun} size={14} class="theme-toggle-sun" />
                                <Icon name={IconName.moon} size={14} class="theme-toggle-moon" />
                            </button>
                        </header>

                        <div class="flex-1 min-h-0 flex flex-col lg:flex-row lg:overflow-hidden overflow-y-auto">
                            <main class="flex-1 min-w-0 lg:overflow-y-auto">
                                <div class="max-w-3xl mx-auto px-5 sm:px-7 lg:px-10 py-6 lg:py-8">
                                    {@raw props.content}
                                </div>
                            </main>
                            <aside class="w-full lg:w-80 shrink-0 border-t lg:border-t-0 lg:border-l border-border bg-background/40 lg:overflow-y-auto flex flex-col">
                                {@raw props.sidebar}
                            </aside>
                        </div>
                    </div>
                </div>
            </TooltipProvider>

            <ToastRegion />
            <script type="module" src="/static/publr-core.js"></script>
            <script type="module" src="/static/publr-portal.js"></script>
            <script type="module" src="/static/publr-position.js"></script>
            <script type="module" src="/static/publr-toast.js"></script>
            <script type="module" src="/static/publr-tooltip.js"></script>
            <script type="module" src="/static/interact/index.js"></script>
            <script type="module" src="/static/publr-query.js"></script>
            <script type="module" src="/static/shell.js"></script>
            <script type="module" src="/static/p/dropdown.js"></script>
        </body>
    </html>
}
