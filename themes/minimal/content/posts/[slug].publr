---
const slug = ctx.param("slug") orelse "unknown";
const post = try ctx.entry("post", slug);
const body = post.data.getText("body") orelse "";
---
<Base>
  <article>
    <p><a href="/posts">← Back to posts</a></p>
    <h1>{post.title}</h1>
    <div class="body">{@raw body}</div>
  </article>
</Base>
